<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="farm_survey">
    <gravity>0 0 -9.81</gravity>
    <physics name="default_physics" type="ode"><max_step_size>0.004</max_step_size><real_time_factor>1</real_time_factor></physics>
    <scene><ambient>0.55 0.55 0.55 1</ambient><background>0.55 0.75 0.95 1</background><shadows>true</shadows></scene>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <light name="sun" type="directional"><cast_shadows>true</cast_shadows><pose>0 0 30 0 0 0</pose><diffuse>0.9 0.9 0.8 1</diffuse><direction>-0.4 0.2 -1</direction></light>
    <model name="farm_ground"><static>true</static>
      <link name="link"><collision name="collision"><geometry><box><size>80 60 0.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>80 60 0.2</size></box></geometry><material><ambient>0.24 0.52 0.18 1</ambient><diffuse>0.32 0.65 0.23 1</diffuse></material></visual></link>
    </model>

    <!-- Dedicated launch and landing area; home coordinates are (10, 16). -->
    <model name="drone_station"><static>true</static><pose>10 16 0 0 0 0</pose>
      <link name="link">
        <collision name="deck_collision"><pose>0 0 0.25 0 0 0</pose><geometry><box><size>8 8 0.3</size></box></geometry></collision>
        <visual name="deck"><pose>0 0 0.25 0 0 0</pose><geometry><box><size>8 8 0.3</size></box></geometry><material><ambient>0.08 0.09 0.11 1</ambient><diffuse>0.14 0.16 0.2 1</diffuse><specular>0.35 0.35 0.4 1</specular></material></visual>
        <visual name="landing_zone"><pose>0 0 0.43 0 0 0</pose><geometry><cylinder><radius>3.15</radius><length>0.08</length></cylinder></geometry><material><ambient>0.85 0.52 0.03 1</ambient><diffuse>0.95 0.68 0.06 1</diffuse></material></visual>
        <visual name="landing_zone_inner"><pose>0 0 0.48 0 0 0</pose><geometry><cylinder><radius>2.75</radius><length>0.03</length></cylinder></geometry><material><ambient>0.08 0.14 0.22 1</ambient><diffuse>0.12 0.22 0.34 1</diffuse></material></visual>
        <visual name="landing_cross_x"><pose>0 0 0.51 0 0 0</pose><geometry><box><size>4.5 0.35 0.04</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="landing_cross_y"><pose>0 0 0.51 0 0 0</pose><geometry><box><size>0.35 4.5 0.04</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="deck_label"><pose>0 0 0.54 0 0 0</pose><geometry><text><text>DRONE</text><font><size>1.0</size></font></text></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="station_sign"><pose>0 3.55 2.35 0 0 0</pose><geometry><box><size>6.5 0.2 1.5</size></box></geometry><material><diffuse>0.08 0.12 0.18 1</diffuse></material></visual>
        <visual name="station_sign_text"><pose>0 3.42 2.35 1.5708 0 0</pose><geometry><text><text>DRONE STATION</text><font><size>0.72</size></font></text></geometry><material><diffuse>0.95 0.75 0.12 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Layered surfaces make the aerial view read as a cultivated farm. -->
