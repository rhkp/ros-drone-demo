storage:
  size: 10Gi
  className: gp3-csi

dataPath: /data/perception

# The demo chart's release name and namespace. Override these two values if the
# farm demo is installed under different names in another cluster.
demo:
  namespace: farm-drone
  zenohService: farm-drone-ros-drone-demo-zenoh

# Keep all RWO PVC consumers on the GPU node when running the PyTorch detector.
placement:
  nodeSelector:
    nvidia.com/gpu.present: "true"
  tolerations:
    - key: g5-gpu
      operator: Exists
      effect: NoSchedule

anchor:
  enabled: true
  image: registry.access.redhat.com/ubi9/ubi-minimal:9.5

# Human-friendly, read-only showcase for datasets, models, and evaluation reports.
viewer:
  enabled: true
  image: registry.access.redhat.com/ubi9/python-311:latest
  port: 8080
  route:
    enabled: true
    host: ""

# Optional camera detector. It never subscribes to simulator truth and publishes
# predictions to a separate topic for the trained Faster R-CNN model.
detector:
  enabled: false
  image: quay.io/rhkp/hbr-drone-observer:v1.2.0
  modelPath: /data/perception/models/v7/detector.pt
  modelVersion: v7
  classNames: well,storage_silo,cattle_shed,produce_barn,crop_field,greenhouse,water_tank
  confidenceThreshold: "0.35"
  outputTopic: /drone/camera_detections

# One-shot perception validator. It may read simulator truth only to score the
# camera-only predictions; it never feeds truth into the detector.
perceptionValidator:
  enabled: false
  image: quay.io/rhkp/hbr-drone-observer:v1.2.0
  durationSec: "240"
  iouThreshold: "0.5"
  modelVersion: v7
  outputPath: /data/perception/evaluations/perception-v7/report.json

# Enable only after publishing an observer image containing dataset_recorder.
recorder:
  enabled: false
  image: quay.io/rhkp/hbr-drone-observer:v1.3.0
  scenario: all
  seed: default
  outputDir: /data/perception/datasets/flight-v6
  captureIntervalSec: 0.5
  maxFrames: 0
  scenarioFile: /opt/drone-demo/config/scenarios.yaml
  predictionTopic: /drone/camera_detections

# One-shot raw-flight curation. It writes a new dataset and never deletes raw data.
curator:
  enabled: false
  image: registry.access.redhat.com/ubi9/python-311:latest
  sources: [flight-v3, flight-v4, flight-crops-v1, flight-water-v1, flight-v5, flight-v6]
  outputDir: /data/perception/datasets/curated-v6
  negativeRatio: 0.35
  splitMap:
    flight-v3: train
    flight-v4: train
    flight-crops-v1: train
    flight-water-v1: train
    flight-v5: validation
    flight-v6: train

# One-shot GPU baseline. The PVC must be unmounted by viewer/anchor first.
trainer:
  enabled: false
  image: pytorch/pytorch:2.4.1-cuda12.1-cudnn9-runtime
  datasetDir: /data/perception/datasets/curated-v6
  modelDir: /data/perception/models/v6
  evalDir: /data/perception/evaluations/v6
  epochs: 12
  batchSize: 4
  seed: "20260914"
  nodeSelector:
    nvidia.com/gpu.present: "true"
  tolerations:
    - key: g5-gpu
      operator: Exists
      effect: NoSchedule
